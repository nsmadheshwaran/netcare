# Copy to .env and change every value marked CHANGE.
POSTGRES_USER=netcare
POSTGRES_PASSWORD=CHANGE-to-a-long-random-password
POSTGRES_DB=netcare

NETCARE_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NETCARE_SECRET_KEY=CHANGE-me
NETCARE_ACCESS_TOKEN_MINUTES=60
# The public URL(s) users open in their browser
NETCARE_CORS_ORIGINS=https://netcare.example.com

# Uploaded documents: per-file limit and per-business quota (MB). Files are stored in the "docstore" volume.
NETCARE_MAX_UPLOAD_MB=15
NETCARE_ORG_STORAGE_QUOTA_MB=2048

# Notifications: email is sent only when SMTP_HOST and SMTP_FROM are set (see docs/NOTIFICATIONS.md).
NETCARE_APP_URL=https://netcare.example.com
NETCARE_SMTP_HOST=
NETCARE_SMTP_PORT=587
NETCARE_SMTP_USER=
NETCARE_SMTP_PASSWORD=
NETCARE_SMTP_FROM=
NETCARE_SMTP_STARTTLS=true

# Stay signed in: sessions end after this many days without use.
NETCARE_REFRESH_TOKEN_DAYS=30
# Optional text-message alerts (costs per message). Provider: twilio or webhook. Channel: sms or whatsapp.
# India: SMS needs a DLT-registered sender ID and templates with your provider.
NETCARE_SMS_PROVIDER=
NETCARE_SMS_CHANNEL=sms
NETCARE_TWILIO_ACCOUNT_SID=
NETCARE_TWILIO_AUTH_TOKEN=
NETCARE_TWILIO_FROM=
NETCARE_SMS_WEBHOOK_URL=
NETCARE_SMS_WEBHOOK_SECRET=
